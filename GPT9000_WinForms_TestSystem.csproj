<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\MitTechApp.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Include="Assets\MitTechLogo.png" LogicalName="Branding.Logo.png" />
    <EmbeddedResource Include="Assets\MitTechApp.ico" LogicalName="Branding.App.ico" />
    <EmbeddedResource Include="Licensing\Provisioning\product-id.txt" Condition="Exists('Licensing\Provisioning\product-id.txt')" LogicalName="Licensing.product-id.txt" />
    <EmbeddedResource Include="Licensing\Provisioning\office-secret.txt" Condition="Exists('Licensing\Provisioning\office-secret.txt')" LogicalName="Licensing.office-secret.txt" />
    <EmbeddedResource Include="Licensing\Provisioning\public-keys.json" Condition="Exists('Licensing\Provisioning\public-keys.json')" LogicalName="Licensing.public-keys.json" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Assets\MitTechApp.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="tools\Create-DesktopShortcut.ps1">
      <TargetPath>Tao-shortcut-MiTTECH.ps1</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="firmware\build\GPT9800_ControlBoard.hex">
      <TargetPath>Firmware\GPT9800_ControlBoard.hex</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="firmware\GPT9800_ControlBoard\GPT9800_ControlBoard.ino">
      <TargetPath>Firmware\GPT9800_ControlBoard\GPT9800_ControlBoard.ino</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="firmware\README.md">
      <TargetPath>Firmware\Huong-dan-thoi-gian.md</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="config.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Config\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="program\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="RequireReleaseLicenseProvisioning" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release'">
    <Error Condition="!Exists('Licensing\Provisioning\product-id.txt') Or !Exists('Licensing\Provisioning\office-secret.txt') Or !Exists('Licensing\Provisioning\public-keys.json')"
           Text="Restore Licensing/Provisioning/product-id.txt, office-secret.txt and public-keys.json before building Release. See Licensing/README.md." />
  </Target>
</Project>
